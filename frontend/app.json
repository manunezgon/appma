{
  "expo": {
    "name": "LaForjaApp",
    "slug": "frontend",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./app/assets/images/black_logo.png",
    "scheme": "laforjaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jabega.laforjaapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jabega.laforjaapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/images/black_logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/images/black_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b542cb30-e3ee-4119-9692-c4bf76b39aad"
      }
    }
  }
}
